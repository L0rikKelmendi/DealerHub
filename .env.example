# DealerHub environment — copy to .env and adjust.
# The docker-compose stack already sets sensible defaults for local development.

# --- Security -----------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database (compose hostnames: db / redis; local: localhost) ---------
DATABASE_URL=postgresql+asyncpg://dealerhub:dealerhub@localhost:5433/dealerhub
TEST_DATABASE_URL=postgresql+asyncpg://dealerhub:dealerhub@localhost:5433/dealerhub_test

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
TEST_REDIS_URL=redis://localhost:6380/1

# --- Misc -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
